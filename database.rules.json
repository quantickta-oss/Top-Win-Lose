{
  "rules": {
    ".read": false,
    ".write": false,
    "pl_manual_roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "pl_manual_reports_v1": {
      "group1": {
        ".read": "auth != null && (root.child('pl_manual_roles').child(auth.uid).val() === 'management' || root.child('pl_manual_roles').child(auth.uid).val() === 'group1')",
        "$branch": {
          ".validate": "$branch === 'awada' || $branch === 'bbc' || $branch === 'fawaz' || $branch === 'egypt'",
          "$report": {
            ".write": "auth != null && (root.child('pl_manual_roles').child(auth.uid).val() === 'management' || root.child('pl_manual_roles').child(auth.uid).val() === 'group1') && newData.exists()",
            ".validate": "newData.hasChildren(['version','branch','date','shift','noClients','updatedAt']) && newData.child('version').val() === 2 && $report === newData.child('date').val() + '_' + newData.child('shift').val() && ((newData.child('noClients').val() === true && !newData.child('rows').exists()) || (newData.child('noClients').val() === false && newData.child('rows').exists()))",
            "version": {
              ".validate": "newData.val() === 2"
            },
            "branch": {
              ".validate": "newData.val() === $branch"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
            },
            "shift": {
              ".validate": "newData.val() === 'am' || newData.val() === 'pm' || newData.val() === 'overnight'"
            },
            "noClients": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "rows": {
              ".validate": "newData.numChildren() <= 6",
              "$i": {
                ".validate": "$i.matches(/^[0-5]$/) && newData.hasChildren(['kind','login','client','cover']) && ((newData.child('kind').val() === 'winner' && newData.child('client').val() > 0) || (newData.child('kind').val() === 'loser' && newData.child('client').val() < 0))",
                "kind": {
                  ".validate": "newData.val() === 'winner' || newData.val() === 'loser'"
                },
                "login": {
                  ".validate": "newData.isString() && newData.val().matches(/^[0-9]+$/) && newData.val().length <= 30"
                },
                "client": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -100000000000000 && newData.val() <= 100000000000000"
                },
                "cover": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -100000000000000 && newData.val() <= 100000000000000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
