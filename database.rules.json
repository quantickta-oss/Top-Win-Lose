{
  "rules": {
    ".read": false,
    ".write": false,
    "pl_manual_roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "pl_manual_reports_v1": {
      "$group": {
        ".read": "auth != null && (root.child('pl_manual_roles').child(auth.uid).val() === 'management' || root.child('pl_manual_roles').child(auth.uid).val() === $group)",
        "$branch": {
          "$date": {
            ".write": "auth != null && (root.child('pl_manual_roles').child(auth.uid).val() === 'management' || root.child('pl_manual_roles').child(auth.uid).val() === $group) && newData.exists() && (($group === 'group1' && ($branch === 'awada' || $branch === 'bbc' || $branch === 'fawaz' || $branch === 'egypt')) || ($group === 'group2' && ($branch === 'boudani' || $branch === 'cdi' || $branch === 'ar' || $branch === 'sh')) || ($group === 'group3' && ($branch === 'connect' || $branch === 'badaro' || $branch === 'mt' || $branch === 'tr')))",
            ".validate": "newData.hasChildren(['version','branch','date','noClients','updatedAt']) && ((newData.child('noClients').val() === true && !newData.child('rows').exists()) || (newData.child('noClients').val() === false && newData.child('rows').exists()))",
            "version": {
              ".validate": "newData.val() === 1"
            },
            "branch": {
              ".validate": "newData.val() === $branch"
            },
            "date": {
              ".validate": "newData.val() === $date && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "updatedAt": {
              ".validate": "newData.isString()"
            },
            "noClients": {
              ".validate": "newData.isBoolean()"
            },
            "rows": {
              "$index": {
                ".validate": "$index.matches(/^[0-5]$/) && newData.hasChildren(['kind','login','name','client','cover'])",
                "kind": {
                  ".validate": "newData.val() === 'winner' || newData.val() === 'loser'"
                },
                "login": {
                  ".validate": "newData.isString() && newData.val().matches(/^[0-9]+$/)"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0"
                },
                "client": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -100000000000000 && newData.val() <= 100000000000000 && ((newData.parent().child('kind').val() === 'winner' && newData.val() > 0) || (newData.parent().child('kind').val() === 'loser' && newData.val() < 0))"
                },
                "cover": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -100000000000000 && newData.val() <= 100000000000000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}